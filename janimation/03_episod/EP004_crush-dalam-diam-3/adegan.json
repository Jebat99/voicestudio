  },
  {
   "mula": 52.389,
   "tamat": 54.195,
   "teks": "“Awak selalu buat saya gembira.”"
  },
  {
   "mula": 54.474,
   "tamat": 58.573,
   "teks": "Amir hanya mampu tersenyum walaupun hatinya mula rasa sedih."
  },
  {
